{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harsh-nod/fe2o3/config/tutorial-compiler-baseline-report-schema-v1.json",
  "title": "fe2o3 tutorial compiler measured baseline report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest", "compiler", "measurement", "pipelineContract", "cases"],
  "properties": {
    "schema": {"const": "fe2o3-tutorial-compiler-baseline-report-v1"},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "corpusContractSha256"],
      "properties": {
        "path": {"const": "config/tutorial-kernel-manifest-v1.json"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpusContractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "worktreeClean"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "worktreeClean": {"const": true}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "target", "toolchain", "measuredAtUtc", "durationClock"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "target": {"type": "string", "pattern": "^gfx[0-9]{3}$"},
        "toolchain": {"type": "string", "minLength": 1},
        "measuredAtUtc": {"type": "string", "format": "date-time"},
        "durationClock": {"const": "CLOCK_MONOTONIC"}
      }
    },
    "pipelineContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "requiredPolicyVersion", "requiredCanonicalKirVersion", "requiredAmdPolicyVersion", "requiredAmdCostModelRevision", "requiredAmdResourceModelRevision", "requiresFinalOptimizedGraphVerification"],
      "properties": {
        "entry": {"const": "rustc-codegen-fe2o3::production_pipeline"},
        "requiredPolicyVersion": {"type": "integer", "minimum": 3},
        "requiredCanonicalKirVersion": {"const": 12},
        "requiredAmdPolicyVersion": {"const": 2},
        "requiredAmdCostModelRevision": {"const": 2},
        "requiredAmdResourceModelRevision": {"const": 3},
        "requiresFinalOptimizedGraphVerification": {"const": true}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixtureId", "testId", "familyIds", "target", "compileTimeNanoseconds", "irSizes", "pipelineOutcome", "compilerMetrics", "artifactResources", "runtimeMetrics", "semanticOutcome"],
        "properties": {
          "fixtureId": {"type": "string", "minLength": 1},
          "testId": {"type": "string", "minLength": 1},
          "familyIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "target": {"type": "string", "pattern": "^gfx[0-9]{3}$"},
          "compileTimeNanoseconds": {"type": "integer", "minimum": 0},
          "irSizes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputNeutralKirBytes", "optimizedNeutralKirBytes", "canonicalKirBytes", "llvmIrBytes", "llvmIrFileCount", "hsacoBytes"],
            "properties": {
              "inputNeutralKirBytes": {"type": "integer", "minimum": 1},
              "optimizedNeutralKirBytes": {"type": "integer", "minimum": 1},
              "canonicalKirBytes": {"type": "integer", "minimum": 1},
              "llvmIrBytes": {"type": "integer", "minimum": 1},
              "llvmIrFileCount": {"const": 1},
              "hsacoBytes": {"type": "integer", "minimum": 1}
            }
          },
          "pipelineOutcome": {
            "type": "object",
            "additionalProperties": false,
            "required": ["compileOnly", "policyVersionObserved", "amdPolicyVersionObserved", "amdCostModelRevisionObserved", "amdResourceModelRevisionObserved", "canonicalKirVersionObserved", "inspectionRecordSha256", "finalTargetKirSha256", "finalVerifiedKirSha256", "finalOptimizedGraphVerificationObserved"],
            "properties": {
              "compileOnly": {"const": "passed"},
              "policyVersionObserved": {"type": "integer", "minimum": 0},
              "amdPolicyVersionObserved": {"const": 2},
              "amdCostModelRevisionObserved": {"const": 2},
              "amdResourceModelRevisionObserved": {"const": 3},
              "canonicalKirVersionObserved": {"const": 12},
              "inspectionRecordSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "finalTargetKirSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "finalVerifiedKirSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "finalOptimizedGraphVerificationObserved": {"const": true}
            }
          },
          "compilerMetrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["peakResidentSetBytes", "diagnosticBytes", "inspectionSidecarBytes", "inspectionRecordBytes", "neutralPassCount", "targetPassCount", "neutralPassWork", "targetPassWork", "optimizerCandidates", "optimizerApplied", "neutralGraphGrowthBytes", "targetBindingAndOptimizationGrowthBytes", "targetResourceModelV3"],
            "properties": {
              "peakResidentSetBytes": {"type": "integer", "minimum": 1},
              "diagnosticBytes": {"type": "integer", "minimum": 0},
              "inspectionSidecarBytes": {"type": "integer", "minimum": 1},
              "inspectionRecordBytes": {"type": "integer", "minimum": 1},
              "neutralPassCount": {"type": "integer", "minimum": 1},
              "targetPassCount": {"type": "integer", "minimum": 1},
              "neutralPassWork": {"type": "integer", "minimum": 0},
              "targetPassWork": {"type": "integer", "minimum": 0},
              "optimizerCandidates": {"type": "integer", "minimum": 0},
              "optimizerApplied": {"type": "integer", "minimum": 0},
              "neutralGraphGrowthBytes": {"type": "integer", "minimum": 0},
              "targetBindingAndOptimizationGrowthBytes": {"type": "integer", "minimum": 0},
              "targetResourceModelV3": {
                "type": "object",
                "additionalProperties": false,
                "required": ["modelRevision", "vgprAllocationGranuleDwordsPerLane", "sgprAllocationGranuleDwordsPerWave", "input", "output", "hardwareObserved", "comparisonPolicy", "comparisonRationale"],
                "properties": {
                  "modelRevision": {"const": 3},
                  "vgprAllocationGranuleDwordsPerLane": {"type": "integer", "minimum": 1},
                  "sgprAllocationGranuleDwordsPerWave": {"type": "integer", "minimum": 1},
                  "input": {"$ref": "#/$defs/targetResourceEstimateV3"},
                  "output": {"$ref": "#/$defs/targetResourceEstimateV3"},
                  "hardwareObserved": {"const": false},
                  "comparisonPolicy": {"const": "compiler-policy-identity-only"},
                  "comparisonRationale": {"const": "replay-validated compiler estimates are policy evidence, not hardware observations"}
                }
              }
            }
          },
          "artifactResources": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agprCount", "sgprCount", "vgprCount", "sgprSpillCount", "vgprSpillCount", "ldsBytes", "privateSegmentBytes", "maxFlatWorkgroupSize", "wavefrontSize", "minimumWavesPerExecutionUnit", "maximumWavesPerExecutionUnit", "occupancyStatus"],
            "properties": {
              "agprCount": {"type": "integer", "minimum": 0},
              "sgprCount": {"type": "integer", "minimum": 0},
              "vgprCount": {"type": "integer", "minimum": 0},
              "sgprSpillCount": {"type": "integer", "minimum": 0},
              "vgprSpillCount": {"type": "integer", "minimum": 0},
              "ldsBytes": {"type": "integer", "minimum": 0},
              "privateSegmentBytes": {"type": "integer", "minimum": 0},
              "maxFlatWorkgroupSize": {"type": "integer", "minimum": 1},
              "wavefrontSize": {"type": "integer", "minimum": 1},
              "minimumWavesPerExecutionUnit": {"type": ["integer", "null"], "minimum": 1},
              "maximumWavesPerExecutionUnit": {"type": ["integer", "null"], "minimum": 1},
              "occupancyStatus": {"enum": ["reported-by-hsaco-metadata", "unavailable-not-emitted"]}
            }
          },
          "runtimeMetrics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "runtimeNanoseconds"],
            "properties": {
              "status": {"enum": ["measured", "not-run-compile-only", "unavailable"]},
              "runtimeNanoseconds": {"type": ["integer", "null"], "minimum": 0}
            }
          },
          "semanticOutcome": {
            "type": "object",
            "additionalProperties": false,
            "required": ["simulator", "reference"],
            "properties": {
              "simulator": {"enum": ["passed", "failed", "not-run", "not-required", "unavailable"]},
              "reference": {"enum": ["passed", "failed", "not-run", "not-required", "unavailable"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "targetResourceEstimateV3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["livenessValues", "livenessWorkUnits", "peakLiveVgprDwordsPerLane", "peakLiveVgprFunction", "peakLiveSgprDwordsPerWave", "peakLiveSgprFunction", "allocatedVgprDwordsPerLane", "allocatedSgprDwordsPerWave", "requiredVgprSpillDwordsPerLane", "requiredSgprSpillDwordsPerWave", "vgprLimitedWavesPerExecutionUnit", "sgprLimitedWavesPerExecutionUnit", "ldsLimitedWavesPerExecutionUnit", "estimatedWavesPerExecutionUnit", "occupancyComplete", "spillAdmissible"],
      "properties": {
        "livenessValues": {"type": "integer", "minimum": 0},
        "livenessWorkUnits": {"type": "integer", "minimum": 0},
        "peakLiveVgprDwordsPerLane": {"type": "integer", "minimum": 0},
        "peakLiveVgprFunction": {"type": "integer", "minimum": 0},
        "peakLiveSgprDwordsPerWave": {"type": "integer", "minimum": 0},
        "peakLiveSgprFunction": {"type": "integer", "minimum": 0},
        "allocatedVgprDwordsPerLane": {"type": "integer", "minimum": 0},
        "allocatedSgprDwordsPerWave": {"type": "integer", "minimum": 0},
        "requiredVgprSpillDwordsPerLane": {"type": "integer", "minimum": 0},
        "requiredSgprSpillDwordsPerWave": {"type": "integer", "minimum": 0},
        "vgprLimitedWavesPerExecutionUnit": {"type": "integer", "minimum": 1},
        "sgprLimitedWavesPerExecutionUnit": {"type": "integer", "minimum": 1},
        "ldsLimitedWavesPerExecutionUnit": {"type": ["integer", "null"], "minimum": 1},
        "estimatedWavesPerExecutionUnit": {"type": "integer", "minimum": 1},
        "occupancyComplete": {"type": "boolean"},
        "spillAdmissible": {"type": "boolean"}
      }
    }
  }
}
