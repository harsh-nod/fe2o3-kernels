{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/harsh-nod/fe2o3/config/tutorial-compiler-no-regression-threshold-schema-v1.json",
  "title": "fe2o3 tutorial compiler no-regression thresholds v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "baseline", "derivation", "families"],
  "properties": {
    "schema": {"const": "fe2o3-tutorial-compiler-no-regression-thresholds-v1"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportSha256", "compilerCommit", "compilerTree", "manifestSha256", "corpusContractSha256", "target"],
      "properties": {
        "reportSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compilerCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "compilerTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpusContractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target": {"type": "string", "pattern": "^gfx[0-9]{3}$"}
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxCompileTimeRegressionBasisPoints", "maxSizeRegressionBasisPoints", "maxResourceRegressionBasisPoints", "maxWorkRegressionBasisPoints", "rounding"],
      "properties": {
        "maxCompileTimeRegressionBasisPoints": {"type": "integer", "minimum": 0, "maximum": 100000},
        "maxSizeRegressionBasisPoints": {"type": "integer", "minimum": 0, "maximum": 100000},
        "maxResourceRegressionBasisPoints": {"type": "integer", "minimum": 0, "maximum": 100000},
        "maxWorkRegressionBasisPoints": {"type": "integer", "minimum": 0, "maximum": 100000},
        "rounding": {"const": "integer-ceiling"}
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["familyId", "target", "fixtures", "requiredPipeline", "requiredSemanticOutcome"],
        "properties": {
          "familyId": {"type": "string", "minLength": 1},
          "target": {"type": "string", "pattern": "^gfx[0-9]{3}$"},
          "fixtures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fixtureId", "maxCompileTimeNanoseconds", "maxInputNeutralKirBytes", "maxOptimizedNeutralKirBytes", "maxCanonicalKirBytes", "requiredLlvmIrFileCount", "maxLlvmIrBytes", "maxHsacoBytes", "maxPeakResidentSetBytes", "maxDiagnosticBytes", "maxInspectionSidecarBytes", "maxInspectionRecordBytes", "requiredNeutralPassCount", "requiredTargetPassCount", "maxNeutralPassWork", "maxTargetPassWork", "maxNeutralGraphGrowthBytes", "maxTargetBindingAndOptimizationGrowthBytes", "maxAgprCount", "maxSgprCount", "maxVgprCount", "maxSgprSpillCount", "maxVgprSpillCount", "maxLdsBytes", "maxPrivateSegmentBytes", "requiredMaxFlatWorkgroupSize", "requiredWavefrontSize", "requiredOccupancyStatus", "minimumMinimumWavesPerExecutionUnit", "minimumMaximumWavesPerExecutionUnit", "requiredRuntimeStatus", "maxRuntimeNanoseconds"],
              "properties": {
                "fixtureId": {"type": "string", "minLength": 1},
                "maxCompileTimeNanoseconds": {"type": "integer", "minimum": 0},
                "maxInputNeutralKirBytes": {"type": "integer", "minimum": 1},
                "maxOptimizedNeutralKirBytes": {"type": "integer", "minimum": 1},
                "maxCanonicalKirBytes": {"type": "integer", "minimum": 1},
                "requiredLlvmIrFileCount": {"const": 1},
                "maxLlvmIrBytes": {"type": "integer", "minimum": 1},
                "maxHsacoBytes": {"type": "integer", "minimum": 1},
                "maxPeakResidentSetBytes": {"type": "integer", "minimum": 1},
                "maxDiagnosticBytes": {"type": "integer", "minimum": 0},
                "maxInspectionSidecarBytes": {"type": "integer", "minimum": 1},
                "maxInspectionRecordBytes": {"type": "integer", "minimum": 1},
                "requiredNeutralPassCount": {"type": "integer", "minimum": 1},
                "requiredTargetPassCount": {"type": "integer", "minimum": 1},
                "maxNeutralPassWork": {"type": "integer", "minimum": 0},
                "maxTargetPassWork": {"type": "integer", "minimum": 0},
                "maxNeutralGraphGrowthBytes": {"type": "integer", "minimum": 0},
                "maxTargetBindingAndOptimizationGrowthBytes": {"type": "integer", "minimum": 0},
                "maxAgprCount": {"type": "integer", "minimum": 0},
                "maxSgprCount": {"type": "integer", "minimum": 0},
                "maxVgprCount": {"type": "integer", "minimum": 0},
                "maxSgprSpillCount": {"type": "integer", "minimum": 0},
                "maxVgprSpillCount": {"type": "integer", "minimum": 0},
                "maxLdsBytes": {"type": "integer", "minimum": 0},
                "maxPrivateSegmentBytes": {"type": "integer", "minimum": 0},
                "requiredMaxFlatWorkgroupSize": {"type": "integer", "minimum": 1},
                "requiredWavefrontSize": {"type": "integer", "minimum": 1},
                "requiredOccupancyStatus": {"enum": ["reported-by-hsaco-metadata", "unavailable-not-emitted"]},
                "minimumMinimumWavesPerExecutionUnit": {"type": ["integer", "null"], "minimum": 1},
                "minimumMaximumWavesPerExecutionUnit": {"type": ["integer", "null"], "minimum": 1},
                "requiredRuntimeStatus": {"enum": ["measured", "not-run-compile-only", "unavailable"]},
                "maxRuntimeNanoseconds": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          },
          "requiredPipeline": {
            "type": "object",
            "additionalProperties": false,
            "required": ["neutralPolicyVersion", "amdPolicyVersion", "amdCostModelRevision", "amdResourceModelRevision", "targetResourceComparisonPolicy", "canonicalKirVersion", "finalOptimizedGraphVerification"],
            "properties": {
              "neutralPolicyVersion": {"type": "integer", "minimum": 3},
              "amdPolicyVersion": {"const": 2},
              "amdCostModelRevision": {"const": 2},
              "amdResourceModelRevision": {"const": 3},
              "targetResourceComparisonPolicy": {"const": "compiler-policy-identity-only"},
              "canonicalKirVersion": {"const": 12},
              "finalOptimizedGraphVerification": {"const": true}
            }
          },
          "requiredSemanticOutcome": {
            "type": "object",
            "additionalProperties": false,
            "required": ["simulator", "reference"],
            "properties": {
              "simulator": {"enum": ["passed", "not-required"]},
              "reference": {"enum": ["passed", "not-required"]}
            }
          }
        }
      }
    }
  }
}
